# Copy to .env and fill in real values. Never commit .env.

# Required — forecasting primary database (SQLAlchemy URL)
SALES_FORECAST_DB_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/finedatalink

# Optional alias used by some NexusBI / monitor modules
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/finedatalink

# Optional tuning
# SKU_ACCURACY_THRESHOLD=0.01
# FORECAST_INTERNAL_SCHEDULER_ENABLED=false
# FORECAST_HISTORY_WINDOW_HOURS=24
# SPU_LIST=

# Optional LLM
# DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_API_KEY
